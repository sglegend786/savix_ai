# Flask secret key - generate any long random string
SECRET_KEY=change-this-to-a-random-secret-string

# Google OAuth credentials
# Get these from https://console.cloud.google.com/apis/credentials
# 1. Create a project -> OAuth consent screen -> External
# 2. Create OAuth Client ID -> Web application
# 3. Add authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: override database location
DATABASE_URL=sqlite:///savix.db
